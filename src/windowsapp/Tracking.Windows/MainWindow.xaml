<Window x:Class="Tracking.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Archive Tracking Web" Width="1180" Height="780" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0F1117">
  <Grid>
    <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
    <Grid x:Name="SetupPanel" Background="#0F1117">
      <Border Width="520" MaxWidth="520" Padding="32" CornerRadius="24"
              Background="#171A23" BorderBrush="#343849" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Connect your library" Foreground="#F7F7FB" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Margin="0,10,0,22" TextWrapping="Wrap" Foreground="#BEC0CC" FontSize="15"
                     Text="Enter the address of your tracking server. Use HTTP for a trusted local server or HTTPS for a secured deployment." />
          <TextBlock Text="Server address" Foreground="#EDEDF5" Margin="0,0,0,7" />
          <TextBox x:Name="ServerInput" Padding="12" FontSize="15" Background="#232735" Foreground="White"
                   BorderBrush="#565B72" CaretBrush="White" />
          <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="#F87171" TextWrapping="Wrap" />
          <Button Margin="0,18,0,0" Padding="14,10" Content="Connect" Click="Connect_Click"
                  Background="#6D28D9" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
          <TextBlock Margin="0,18,0,0" Foreground="#9195A8" FontSize="12" TextWrapping="Wrap"
                     Text="This application displays the hosted Vue interface, so normal frontend updates appear automatically." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
