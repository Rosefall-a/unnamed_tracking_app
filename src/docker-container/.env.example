# Production container example environment
UNNAMED_TRACKING_APP_VERSION=latest
UNNAMED_TRACKING_APP_PORT=8080

POSTGRES_USER=unnamed_tracking
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=unnamed_tracking

SECRET_KEY=replace-with-a-long-random-secret
PRIMARY_USER_USERNAME=admin
PRIMARY_USER_EMAIL=admin@example.com
PRIMARY_USER_PASSWORD=replace-with-a-strong-password

# Set true only when the public endpoint is HTTPS.
AUTH_COOKIE_SECURE=false

# Optional embedded TLS. Disabled by default.
# If TLS is enabled without certificate/key paths, an existing /etc/nginx/tls pair is used when present; otherwise a self-signed localhost certificate is generated.
# NGINX_TLS_ENABLED=false
# NGINX_TLS_CERTIFICATE=/etc/nginx/tls/tls.crt
# NGINX_TLS_PRIVATE_KEY=/etc/nginx/tls/tls.key
# NGINX_TLS_REDIRECT_HTTP=false

# Shared internal host/runtime transport secret (at least 32 random characters).
PLUGIN_RUNTIME_TOKEN=replace-with-a-random-32-byte-or-longer-token

# Optional fallback override; approval can also be given in Plugin Manager.
# True disables per-plugin namespaces and suppresses the persistent warning.
# Leave false to retain normal isolation or require an administrator's approval.
NONBUBBLE_ENV=false
# Real client-IP handling is loopback-only by default.
# Settings/setup can persist additional trusted proxy ranges. Environment
# values take precedence over saved deployment settings.
# NGINX_REALIP_HEADER=X-Forwarded-For
# NGINX_REALIP_TRUSTED_PROXIES=127.0.0.1/32 ::1/128
