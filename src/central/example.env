# Copy this to the repository root as .env before starting the central Compose examples.
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archive
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Optional full PostgreSQL URL override. When present it takes precedence over
# the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/archive

# Do not add SECRET_KEY here for normal installations. The backend generates
# and persists its Fernet key under /data/config/fernet.key.


# Optional first-admin bootstrap. If omitted, the /setup page creates the first admin.
# PRIMARY_USER_USERNAME=admin
# PRIMARY_USER_EMAIL=admin@example.com
# PRIMARY_USER_PASSWORD=Change-this-during-setup
# Set BYPASS_SETUP=true to require environment bootstrap credentials and skip the web setup menu.
# BYPASS_SETUP=false

# Optional encrypted deployment settings bootstrap. Put the exported Settings ->
# Backup JSON at /data/application.json and provide its export password.
# APPLICATION_JSON_PASSWORD=your-settings-export-password
# APPLICATION_JSON_PATH=/data/application.json
