# Copy this file to .env before running src/central/docker-compose.yaml.
# Replace every placeholder marked as a secret before using it outside local development.

POSTGRES_USER=post_user
POSTGRES_PASSWORD=change_me_to_a_strong_database_password
POSTGRES_DB=the_db

PRIMARY_USER_USERNAME=admin
PRIMARY_USER_EMAIL=admin@example.com
PRIMARY_USER_PASSWORD=Change-this-during-setup
AUTH_COOKIE_SECURE=false

# Generate a real value for production, for example with the command documented in example.env.
SECRET_KEY=generate_a_real_fernet_key_for_this
MAX_UPLOAD_SIZE_MB=15

STEAMGRIDDB_API_KEY=your_api_key_here
SCREENSCRAPER_DEVID=
SCREENSCRAPER_DEVPASSWORD=

# BACKEND_URL is optional. The central image chooses it from APP_MODE:
#   APP_MODE=both     -> http://127.0.0.1:8000
#   APP_MODE=frontend -> http://backend:8000
# Set BACKEND_URL explicitly when your separate backend uses another service
# name, hostname, port, or external URL.
