# Copy this to the repository root as .env before starting the central Compose examples.
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archive
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Optional full PostgreSQL URL override. When present it takes precedence over
# the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/archive

# Do not add SECRET_KEY here for normal installations. The backend generates
# and persists its Fernet key under /data/config/fernet.key.
