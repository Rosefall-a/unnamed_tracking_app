FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Java 25 JRE — BlueMap 5.23's cli jar is compiled for class file version 69
# (Java 25); Debian bookworm's own openjdk-21 package is too old to run it,
# so this pulls the Temurin tarball directly instead of relying on apt.
RUN curl -fL -o /tmp/jre.tar.gz \
    https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jre_x64_linux_hotspot_25.0.4.1_1.tar.gz \
    && mkdir -p /opt/java \
    && tar -xzf /tmp/jre.tar.gz -C /opt/java --strip-components=1 \
    && rm /tmp/jre.tar.gz
ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# BlueMap CLI — renders a Minecraft world save into a static web map (see
# features/world_map/bluemap.py). Pinned version, downloaded once at build
# time rather than lazily at render time so a render never depends on
# GitHub being reachable from the running container.
RUN curl -fL -o /opt/bluemap-cli.jar \
    https://github.com/BlueMap-Minecraft/BlueMap/releases/download/v5.23/bluemap-5.23-cli.jar

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code into src/ subdirectory
COPY src /app/src

COPY alembic.ini /app/alembic.ini

# Validate that Alembic can load and traverse the complete migration graph.
# Multiple heads are valid when migrations were developed in parallel; the
# startup command upgrades to all heads so every pending branch is applied.
RUN python - <<'PY'
from alembic.config import Config
from alembic.script import ScriptDirectory

script = ScriptDirectory.from_config(Config("alembic.ini"))
heads = script.get_heads()
revisions = list(script.walk_revisions())
print("Alembic heads:", heads)
print("Alembic revisions loaded:", len(revisions))
if not heads:
    raise SystemExit("Alembic migration graph has no head revisions")
PY

# Copy and prepare the entrypoint script
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

# Expose port
EXPOSE 8000

# On start: run all pending migration heads, then launch the app
ENTRYPOINT ["./entrypoint.sh"]
