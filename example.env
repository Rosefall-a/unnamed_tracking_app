# PostgreSQL connection used by the backend and the Compose db service.
# DATABASE_URL is optional: when omitted, the backend assembles it from
# POSTGRES_USER/PASSWORD/DB plus the optional POSTGRES_HOST/PORT below.
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archive
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Optional escape hatch for an externally managed PostgreSQL instance.
# DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/archive

# Normal application configuration is completed from the first-run setup page
# and Settings. This includes the administrator, OIDC, SMTP, provider API
# credentials, upload limits, and secure-cookie setting.
#
# The application generates and persists its Fernet encryption key automatically
# under APP_DATA_DIR/config/fernet.key. Do not generate SECRET_KEY manually.
# Existing installations may keep SECRET_KEY temporarily as a one-time
# backwards-compatible bootstrap value; it is copied into persistent storage.
