# PostgreSQL deployment inputs. New deployments should use these instead of DATABASE_URL.
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archive
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional deployment profile. Leave unset for normal/default values.
# development supplies a disposable initial admin for local development.
# testing supplies reduced test defaults.
STARTUP_MODE=
# Set to forced to keep the setup/configuration UI available after setup.
# STARTUP_UI=forced

# SECRET_KEY is deployment-owned. If omitted, the application generates and
# persists a stable Fernet key under APP_DATA_DIR/config.
# APP_DATA_DIR=/data
SECRET_KEY=

AUTH_COOKIE_SECURE=false
DEBUG=false
MAX_UPLOAD_SIZE_MB=15
MAX_SAVE_ARCHIVE_SIZE_MB=4096
MAX_CLIP_SIZE_MB=500
MAX_WORLD_SAVE_SIZE_MB=2000

# Frontend-only development/testing switch. This is intentionally ENV-only and
# is not exposed through the setup page.
VITE_USE_MOCK_DATA=false

STEAMGRIDDB_API_KEY=
RETROACHIEVEMENTS_API_KEY=
GIANTBOMB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TMDB_API_KEY=
OMDB_API_KEY=
TVDB_API_KEY=
SCREENSCRAPER_DEVID=
SCREENSCRAPER_DEVPASSWORD=
SCREENSCRAPER_SSID=
SCREENSCRAPER_SSPASSWORD=

# OIDC remains supported as an environment fallback for existing deployments.
# New installations may configure OIDC through the setup/settings flow.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
OIDC_USER_MATCH_FIELD=email

# Legacy compatibility only; prefer the three POSTGRES_* variables above.
# DATABASE_URL=postgresql+psycopg://archive:change-this-database-password@db:5432/archive

# Legacy first-user bootstrap remains supported. STARTUP_MODE=development can
# supply a disposable development account when these are omitted.
# PRIMARY_USER_USERNAME=admin
# PRIMARY_USER_EMAIL=admin@example.com
# PRIMARY_USER_PASSWORD=Change-this-during-setup
