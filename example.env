POSTGRES_USER=post_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=the_db
VITE_API_BASE_URL=http://Your url:5173 # why do we need this?
PRIMARY_USER_USERNAME=admin
PRIMARY_USER_EMAIL=admin@example.com
PRIMARY_USER_PASSWORD=Change-this-during-setup  # requires 1 capital letter and 1 symbol
AUTH_COOKIE_SECURE=false
STEAMGRIDDB_API_KEY=your_api_key_here
# Generate with: openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
SECRET_KEY=generate_a_real_fernet_key_for_this
MAX_UPLOAD_SIZE_MB=15
# Optional — app-wide dev credentials for metadata providers that need them.
# Leave unset and that provider just shows as unavailable in Settings.
# IGDB is NOT configured here — it's entered by an admin through
# Settings > Metadata/API instead, so a downloaded copy of this app never
# ships with someone else's credentials baked into .env.
SCREENSCRAPER_DEVID=
SCREENSCRAPER_DEVPASSWORD=