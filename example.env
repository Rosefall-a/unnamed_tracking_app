POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=the_db
VITE_API_BASE_URL=http://Your url:5173 # why do we need this?

# The first administrator is created from the web-based setup page on first run.
# Legacy PRIMARY_USER_* variables are optional and are only needed for existing
# deployments that still want to seed the original account automatically.
# PRIMARY_USER_USERNAME=admin
# PRIMARY_USER_EMAIL=admin@example.com
# PRIMARY_USER_PASSWORD=Change-this-during-setup

AUTH_COOKIE_SECURE=false
SECRET_KEY=replace-with-a-fernet-key

# Optional OpenID Connect / SSO
# OIDC_ISSUER_URL=https://login.example.com/realms/archive
# OIDC_CLIENT_ID=archive
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URI=https://archive.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
