POSTGRES_USER=archive
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archive

# Browser-facing URL. The frontend proxies /api to the backend in Docker Compose.
VITE_API_BASE_URL=http://localhost:5173

# Required: valid Fernet key used for encryption at rest.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace-with-a-generated-fernet-key
AUTH_COOKIE_SECURE=false
STEAMGRIDDB_API_KEY=your_api_key_here
# Generate with: openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
SECRET_KEY=generate_a_real_fernet_key_for_this
MAX_UPLOAD_SIZE_MB=15
# Optional — app-wide dev credentials for metadata providers that need them.
# Leave unset and that provider just shows as unavailable in Settings.
# The metadata keys below can be set here or entered by an admin in
# Settings > Metadata Sources. A key saved in Settings wins over these, and
# nothing ships with the app, so a downloaded copy never carries anyone
# else's credentials. Leave them blank to use Settings instead.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TMDB_API_KEY=
OMDB_API_KEY=
TVDB_API_KEY=
SCREENSCRAPER_DEVID=
SCREENSCRAPER_DEVPASSWORD=

# The first administrator is created from the web-based setup page on first run.
# Legacy PRIMARY_USER_* variables are optional and only needed for existing
# deployments that still want to seed the original account automatically.
# PRIMARY_USER_USERNAME=admin
# PRIMARY_USER_EMAIL=admin@example.com
# PRIMARY_USER_PASSWORD=Change-this-during-setup

# New installations should configure provider API keys and OIDC from
# Settings -> OIDC / SSO. The variables below remain supported as
# backwards-compatible fallbacks for existing deployments.
# OIDC_ISSUER_URL=https://login.example.com/realms/archive
# OIDC_CLIENT_ID=archive
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_USER_MATCH_FIELD=email
